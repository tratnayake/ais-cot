# Get from https://aisstream.io/
AISSTREAM_API_KEY=<CHANGE_ME>

TAK_HOST=192.168.1.125
TAK_PORT=8087

BBOX_LAT_MIN=48.8408
BBOX_LAT_MAX=49.7392
BBOX_LON_MIN=-123.7889
BBOX_LON_MAX=-122.4111

TYPE_FILTER=30,36,37,60,61,62,63,64,65,69,70,71,72,73,74,79,80,81,89

# How often to push vessel positions to TAK (seconds)
UPDATE_RATE=60

# How long TAK holds a contact with no update (seconds)
COT_STALE=120

